{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "firefox",
            "request": "launch",
            "reAttach": true,
            "name": "Launch localhost",
            "url": "http://localhost:6001/src",
            "firefoxExecutable": "C:\\UserPrograms\\Internet\\Firefox\\firefox.exe",
            "webRoot": "${workspaceFolder}/src",
            "pathMappings": [
                {
                    "url": "http://localhost:6001/src",
                    "path": "${workspaceFolder}/src"
                }
            ]
        },

        {
            "name": "Launch Chrome",
            "request": "launch",
            "type": "chrome",
            "url": "http://localhost:6001/",
            "trace": true,
            "sourceMaps": true,
            "perScriptSourcemaps": "yes",
            "webRoot": "${workspaceFolder}/src"
        }
    ],

}