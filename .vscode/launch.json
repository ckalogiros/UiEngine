{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "firefox",
            "request": "launch",
            "reAttach": true,
            "name": "http://localhost:6001",
            "file": "${workspaceFolder}/src/index.html"
        },
        
        {
            "type": "chrome",
            "request": "launch",
            "name": "Launch Chrome against localhost",
            "sourceMaps": true,
            "url": "http://localhost:6001",
            "webRoot": "${workspaceFolder}/src"
        },

    ],
}