{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "chrome",
            "request": "attach",
            "name": "Attach to Chrome",
            "port": 6001,
            "webRoot": "${workspaceFolder}/src"
        },

        {
            "type": "msedge",
            "name": "Launch Microsoft Edge",
            "request": "launch",
            "cleanUp": "wholeBrowser",
            "cascadeTerminateToConfigurations": [
                "Open Edge DevTools"
            ],
            "url": "http:localhost:6001",
            "presentation": {
                "hidden": true
            }
        },
        {
            "type": "msedge",
            "name": "Launch Microsoft Edge in headless mode",
            "request": "launch",
            "runtimeArgs": [
                "--headless",
                "--remote-debugging-port=6001"
            ],
            "url": "http:localhost:3000",
            "presentation": {
                "hidden": true
            }
        },
        {
            "type": "vscode-edge-devtools.debug",
            "name": "Open Edge DevTools",
            "request": "attach",
            "url": "http:localhost:3000",
            "presentation": {
                "hidden": true
            }
        },
        {
            "type": "chrome",
            "request": "launch",
            "name": "Launch Chrome against localhost",
            "url": "http://localhost:6001/src/index.html",
            "webRoot": "${workspaceFolder}/src",
            "sourceMaps": false,
            "trace": true, // Add this to get debug logs
            "skipFiles": ["<node_internals>/**"],
            "runtimeArgs": [
                "--disable-extensions",
                // "--no-sandbox",
                "--disable-gpu",
                //     "--enable-source-maps"
            ]
            
        },

    ],
    "compounds": [
        {
            "name": "Launch Edge Headless and attach DevTools",
            "configurations": [
                "Launch Microsoft Edge in headless mode",
                "Open Edge DevTools"
            ],
            "stopAll": true
        },
        {
            "name": "Launch Edge and attach DevTools",
            "configurations": [
                "Launch Microsoft Edge",
                "Open Edge DevTools"
            ],
            "stopAll": true
        }
    ]
}